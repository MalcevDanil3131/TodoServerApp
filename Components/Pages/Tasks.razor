@page "/"
@using Microsoft.AspNetCore.Authorization
@using TodoServerApp.Data
@using TodoServerApp.Data.Interfaces
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDataService Data
@inject NavigationManager Navigation

<PageTitle>Задачи</PageTitle>
<h1>Мои задачи</h1>

<div class="container">
    @if (tasks is null)
    {
        <p>Loading ...</p>
    }
    else
    {
        <div class="btn-group m-2">
            <button type="button" class="btn btn-primary" @onclick="AddTask">Новая задача</button>
        </div>

        <div class="card-group">
            @foreach (var task in tasks)
            {
                <div class="card" @key="task.Id">
                    <div class="card-header">@task.Title</div>
                    <div class="card-body">
                        <p>@task.Description</p>
                        <p>@task.CreatedDate</p>
                    </div>
                    <div class="card-footer">
                        <a class="btn btn-primary" href="@($"/tasks/{task.Id}")">Изменить</a>
                        <button type="button" class="btn btn-primary"
                                @onclick="() => DeleteTaskAsync(task.Id)">Удалить</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IEnumerable<TaskItem>? tasks;
    private bool deleting;

    protected override async Task OnInitializedAsync()
    {
        tasks = await Data.GetTaskItemsAsync();
    }

    private void AddTask()
    {
        Navigation.NavigateTo("/tasks/add");
    }

    private async Task DeleteTaskAsync(int id)
    {
        if (deleting)
        {
            return;
        }

        deleting = true;
        try
        {
            await Data.DeleteAsync(id);
            tasks = await Data.GetTaskItemsAsync();
        }
        finally
        {
            deleting = false;
        }
    }
}
