@page "/tasks/add"
@page "/tasks/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using TodoServerApp.Data
@using TodoServerApp.Data.Interfaces
@attribute [Authorize]
@inject IDataService Data
@inject NavigationManager Navigation

@if (Model is not null)
{
    <EditForm Model="Model" FormName="TaskForm" OnValidSubmit="ValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <h2>Новая задача</h2>
        <InputNumber @bind-Value="Model.Id" hidden />
        <div class="form-group d-flex justify-content-between m-2">
            <label for="title" class="col-form-label col-3">Заголовок</label>
            <InputText id="title" class="form-control" @bind-Value="Model.Title" />
            <ValidationMessage For="() => Model.Title" />
        </div>
        <div class="form-group d-flex justify-content-between m-2">
            <label for="description" class="col-form-label col-3">Описание</label>
            <InputTextArea id="description" class="form-control" @bind-Value="Model.Description" />
            <ValidationMessage For="() => Model.Description" />
        </div>
        <div class="form-group d-flex justify-content-between m-2">
            <label for="finish-date" class="col-form-label col-3">Дата окончания</label>
            <InputDate id="finish-date" class="form-control" @bind-Value="Model.FinishDate" />
            <ValidationMessage For="() => Model.FinishDate" />
        </div>
        <div class="btn-group">
            <button type="submit" class="btn btn-primary m-2">Сохранить</button>
            <a class="btn btn-primary m-2" href="/">Отмена</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    [SupplyParameterFromForm(FormName = "TaskForm")]
    private TaskItem? Model { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Model ??= Id is int id ? await Data.GetTaskAsync(id) : new TaskItem();
        if (Model is null)
        {
            Navigation.NotFound();
        }
    }

    private async Task ValidSubmit()
    {
        if (await Data.SaveAsync(Id, Model!))
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            Navigation.NotFound();
        }
    }
}
